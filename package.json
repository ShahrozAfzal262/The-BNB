{
  "name": "stayora-marketplace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "seed:reset": "npm --prefix backend run seed:reset",
    "seed:host": "npm --prefix backend run seed:host --",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
